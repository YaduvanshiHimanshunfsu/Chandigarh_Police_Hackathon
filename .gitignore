# ── Python ───────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# ── Virtual environments ──────────────────────────────
.venv/
venv/
env/
ENV/

# ── ML Models (binary, too large for git) ────────────
backend/models/*.onnx
backend/models/*.h5
backend/models/*.pt
backend/models/*.pth
backend/models/*.bin
mobilenetV2-main.zip

# ── Uploads & Reports (runtime generated) ────────────
backend/uploads/*
!backend/uploads/.gitkeep
backend/reports/*
!backend/reports/.gitkeep

# ── Environment files (secrets) ──────────────────────
.env
.env.*
!.env.example

# ── Node.js ──────────────────────────────────────────
node_modules/
.next/
frontend/.next/
frontend/node_modules/
frontend/out/
frontend/build/
*.tsbuildinfo

# ── Database & Alembic cache ─────────────────────────
*.db
*.sqlite3

# ── Docker volumes ────────────────────────────────────
postgres_data/

# ── IDE & OS ─────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ─────────────────────────────────────────────
*.log
logs/

# ── Test coverage ─────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/

# ── Alembic (migration versions are fine, but not cache) ─
backend/alembic/__pycache__/
